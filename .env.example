# Copiá este archivo a ".env" y completá con los datos de tu proyecto Supabase
# (Project Settings > API en app.supabase.com).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Datos que se muestran en "Publicar mi cabaña" para la transferencia bancaria.
VITE_BANK_ALIAS=winehouse.cabanas
VITE_BANK_CBU=0000003100000000000000
VITE_BANK_HOLDER=WineHouse Cabañas
VITE_WHATSAPP_CONTACTO=5492610000000
